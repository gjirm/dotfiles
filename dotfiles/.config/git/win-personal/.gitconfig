[user]
	name = Jiri Matejicek
	email = jirm@jirm.cz
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOThRwAc04LH29sPNlSeIc5BIleanqOUfDuhlEdPdmga

[core]
	excludesfile = ~/.gitignore
	autocrlf = false
	longpaths = true
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

[gpg]
    format = ssh

[gpg "ssh"]
	program = C:/Windows/System32/OpenSSH/ssh-keygen.exe

[commit]
    gpgsign = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[credential]
	helper = manager
